#!/usr/bin/env python3
"""
Google Calendar Two-Way Multi-Calendar Cloud Sync CLI for Omarchy Clock.
Handles OAuth 2.0 authentication with PKCE & state validation, secure 0600 storage,
listing all calendars in account, fetching events across all calendars, adding and deleting events.
"""

