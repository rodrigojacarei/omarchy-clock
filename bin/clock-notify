#!/bin/bash
# Omarchy Clock Desktop Notification Dispatcher
GLYPH="$1"
TITLE="$2"
BODY="$3"
MEET_URL="$4"
URGENCY="${5:-critical}"

# Convert literal \n sequences into real newlines
BODY=$(printf '%b' "$BODY")

# Validate MEET_URL: strictly parse HTTPS URL matching allowed meeting hosts
VALID_MEET=0
if [ -n "$MEET_URL" ]; then
  if [[ "$MEET_URL" =~ ^https://([a-zA-Z0-9.-]+\.)?(meet\.google\.com|zoom\.us|teams\.microsoft\.com|teams\.live\.com|webex\.com|meet\.jit\.si)(:[0-9]+)?(/[^\s\"\'\`\<\>\\]*)?$ ]]; then
    VALID_MEET=1
  fi
fi

if [ -x "/usr/share/omarchy/bin/omarchy-notification-send" ]; then
  if [ "$VALID_MEET" -eq 1 ]; then
    /usr/share/omarchy/bin/omarchy-notification-send -g "${GLYPH:-󰕧}" -u "$URGENCY" "$TITLE" "$BODY" --exec xdg-open "$MEET_URL" 2>/dev/null
  else
    /usr/share/omarchy/bin/omarchy-notification-send -g "${GLYPH:-󰃭}" -u "$URGENCY" "$TITLE" "$BODY" 2>/dev/null
  fi
else
  # Fallback to notify-send with -t 0 (no timeout)
  notify-send -a "omarchy-action" -i "appointment-soon" -u "$URGENCY" -t 0 "$TITLE" "$BODY" 2>/dev/null
fi
